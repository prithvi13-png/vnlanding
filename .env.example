# Public site origin, used for canonical URLs, sitemap and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=https://www.vriddhinexus.com

# Travel service URLs. Only Bus is live today — config/services.ts hardcodes
# each service's status, so setting a URL here does not by itself activate
# a coming-soon service; the status flag in config/services.ts must also
# change to "live". A service with status "live" but no URL falls back to
# ComingSoonModal rather than rendering a broken link.
NEXT_PUBLIC_BUS_URL=https://vnbus-api.vercel.app
NEXT_PUBLIC_FLIGHT_URL=
NEXT_PUBLIC_TRAIN_URL=
NEXT_PUBLIC_CAR_URL=

# There is no contact form — every enquiry CTA opens a mailto: link to
# config/site.ts's contactEmail (see lib/mailto.ts). No endpoint to configure.
