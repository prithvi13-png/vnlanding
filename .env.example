# Public site origin, used for canonical URLs, sitemap and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=https://www.vriddhinexus.com

# Base URL of the live Bus Booking subdomain (Phase 1's only operational service).
# lib/busBooking.ts falls back gracefully if this is unset.
NEXT_PUBLIC_BUS_BOOKING_URL=https://bus.vriddhinexus.com

# Endpoint the contact form POSTs to. If unset, the contact page shows a
# "not yet configured" error state instead of faking a successful submission.
NEXT_PUBLIC_CONTACT_API_URL=https://api.vriddhinexus.com/contact
